managed with additional save implementation in class ZBP_I_ZFICONTIPROV_S unique;
strict;
with draft;
define behavior for ZI_ZfiContiProv_S alias ZfiContiProvAll
draft table ZFI_CONTI_P_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )
{
  field ( readonly )
   SingletonID;

  field ( features : instance )
   TransportRequestID;

  field ( notrigger )
   SingletonID,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit with additional implementation;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _ZfiContiProv { create ( features : instance ); with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT
  {
    create;
    update;
  }

  side effects
  {
    action SelectCustomizingTransptReq affects
        $self;
  }

}

define behavior for ZI_ZfiContiProv alias ZfiContiProv ##UNMAPPED_FIELD
persistent table ZFI_CONTI_PROV
draft table ZFI_CONTI_PRO_D
lock dependent by _ZfiContiProvAll
authorization dependent by _ZfiContiProvAll
{
  field ( mandatory : create )
   Bukrs,
   Hkont;

  field ( readonly )
   SingletonID;

  field ( readonly : update )
   Bukrs,
   Hkont;

  field ( notrigger )
   SingletonID;


  update( features : global );
  delete( features : global );

  factory action ( features : instance ) Copy parameter ZD_CopyZfiContiProvP [1];

  mapping for ZFI_CONTI_PROV
  {
    Bukrs = BUKRS;
    Hkont = HKONT;
  }

  association _ZfiContiProvAll { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT
  {
    create;
    update;
    delete;
  }

}