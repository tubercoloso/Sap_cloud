managed with additional save implementation in class ZBP_I_ZFISTATO_S unique;
strict;
with draft;
define behavior for ZI_ZfiStato_S alias ZfiStatoAll
draft table ZFI_STATO_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )
{
  field ( readonly )
   SingletonID;

  field ( features : instance )
   TransportRequestID;

  field ( notrigger )
   SingletonID,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit with additional implementation;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _ZfiStato { create ( features : instance ); with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT
  {
    create;
    update;
  }

  side effects
  {
    action SelectCustomizingTransptReq affects
        $self;
  }

}

define behavior for ZI_ZfiStato alias ZfiStato ##UNMAPPED_FIELD
persistent table ZFI_STATO
draft table ZFI_STATO_D
lock dependent by _ZfiStatoAll
authorization dependent by _ZfiStatoAll
{
  field ( mandatory : create )
   Code;

  field ( readonly )
   SingletonID;

  field ( readonly : update )
   Code;

  field ( notrigger )
   SingletonID;


  update( features : global );
  delete( features : global );

  factory action ( features : instance ) Copy parameter ZD_CopyZfiStatoP [1];

  mapping for ZFI_STATO
  {
    Code = CODE;
    Description = DESCRIPTION;
  }

  association _ZfiStatoAll { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT
  {
    create;
    update;
    delete;
  }

}